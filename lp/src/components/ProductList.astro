---
import ProductCard from './ProductCard.astro';

interface Product {
  name: string;
  year: string;
  icon: string;
  description: string;
  tags: string[];
  github: string;
  youtube?: string;
  awards?: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<section id="products" class="bg-slate-50 py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <span
        class="inline-block px-4 py-1.5 mb-4 text-xs font-bold text-orange-600 bg-orange-100 rounded-full tracking-widest uppercase"
      >
        Our History
      </span>
      <h2 class="text-4xl font-extrabold text-slate-900 mt-2 tracking-tight">
        Collection of Works
      </h2>
      <p class="text-lg text-slate-600 mt-4 max-w-xl mx-auto">
        てりたまがこれまでリリースしてきたプロダクト
      </p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((product) => <ProductCard {...product} />)}
    </div>
  </div>
</section>
